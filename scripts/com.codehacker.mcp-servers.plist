<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Code Hack AI Expert — MCP servers autostart (macOS LaunchAgent template)

  This file is a TEMPLATE. `scripts/install_autostart.sh` renders it with the
  real project path and copies it to ~/Library/LaunchAgents/.
  Do NOT edit the installed copy directly — re-run the installer instead.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.codehacker.mcp-servers</string>

    <!-- Wrap in bash so env (PATH incl. uv) is resolved properly -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__PROJECT_DIR__/start_servers.sh</string>
        <string>start</string>
    </array>

    <key>StandardOutPath</key>
    <string>__PROJECT_DIR__/.mcp_pids/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT_DIR__/.mcp_pids/launchd.log</string>

    <!-- Run at login -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Script backgrounds the servers itself and exits, so no KeepAlive
         on the script. Actual server liveness is managed via PID files. -->
    <key>KeepAlive</key>
    <false/>

    <key>WorkingDirectory</key>
    <string>__PROJECT_DIR__</string>
</dict>
</plist>
